{
  "version": "1.5.1",
  "description": "Explicit control criticality (v1.5.0 M6). Declares what each control must do on failure so a silently-disarmed guard is impossible to mistake for 'all good'. safety = fail closed (on its own failure, block + log); quality = block completion/release; advisory = warn only.",
  "controls": {
    "danger-guard": {
      "criticality": "safety"
    },
    "settings-deny": {
      "criticality": "safety"
    },
    "ci-observe": {
      "criticality": "safety"
    },
    "ship-gate": {
      "criticality": "quality"
    },
    "review-gate": {
      "criticality": "quality"
    },
    "evidence-gate": {
      "criticality": "quality"
    },
    "verify-turn": {
      "criticality": "quality"
    },
    "plan-check": {
      "criticality": "quality"
    },
    "task-triage": {
      "criticality": "advisory"
    },
    "understand-guard": {
      "criticality": "advisory"
    },
    "discipline-guard": {
      "criticality": "advisory"
    },
    "perf-guard": {
      "criticality": "advisory"
    },
    "design-review": {
      "criticality": "quality"
    },
    "hotspot-report": {
      "criticality": "advisory"
    }
  }
}
